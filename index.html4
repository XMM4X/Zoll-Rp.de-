<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <title>Virus-Installation</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: black;
      color: lime;
      text-align: center;
      padding-top: 100px;
    }
    .bar {
      width: 300px;
      border: 1px solid lime;
      margin: 20px auto;
    }
    .fill {
      width: 0%;
      height: 20px;
      background: lime;
      animation: load 5s forwards;
    }
    @keyframes load {
      to { width: 100%; }
    }
  </style>
</head>
<body>
  <h1>Virus wird installiert…</h1>
  <div class="bar"><div class="fill"></div></div>  
</body>
</html>
